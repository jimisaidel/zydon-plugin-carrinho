{
  "name": "zydon-plugin-carrinho",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && cross-env VITE_MODE=production vite build",
    "build:app": "tsc -b && vite build --mode app",
    "build:checkout": "tsc -b && vite build --mode checkout",
    "build:product-detail": "tsc -b && vite build --mode product-detail",
    "test": "jest --ci --collectCoverage=false",
    "report": "jest --ci --coverage --reporters=default --reporters=jest-junit",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch --collectCoverage=false",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint --fix src/**/*.{jsx,ts,tsx}",
    "format": "prettier --write \"**/*.*\""
  },
  "dependencies": {
    "@emotion/react": "11.13.3",
    "@emotion/styled": "11.13.0",
    "@mui/lab": "5.0.0-alpha.173",
